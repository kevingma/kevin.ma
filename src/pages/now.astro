---
import NowList from "../components/NowList.astro";
import Base from "../layouts/Base.astro";
import { getNowLines, getShelf } from "../lib/shelf";

const shelf = await getShelf();
const hasNow = shelf.now.length > 0 || (await getNowLines()).length > 0;
---

<Base title="Now">
  {
    hasNow && (
      <section>
        <h2>now</h2>
        <NowList />
      </section>
    )
  }

  {
    shelf.next.length > 0 && (
      <section>
        <h2>
          next <a href="/shelf">shelf →</a>
        </h2>
        <ul class="rows wide-lead">
          {shelf.next.slice(0, 5).map((item) => (
            <li class="row">
              <span class="lead">{item.kind}</span>
              <span class="what">
                <span class="title">{item.title}</span>
                {item.creator && <span class="by">{item.creator}</span>}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
